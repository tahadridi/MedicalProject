{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/app/layout.js", "src/seed.js", "src/models/Medecin.js", "src/app/pages/api/messages.ts", "src/app/components/Header.js", "src/app/patient/find_by_email/[id]/route.js", "src/app/api/doctors/notifications/route.js", "src/models/Notification.js", "src/app/api/doctors/email/[email]/route.js", "src/app/api/medications/route.ts", "src/app/DoctorDashboard/components/NotesVisualise.jsx"],
  "exclude": ["node_modules"]
}
